# Public DNS names pointing at the test server.
TEST_APP_HOST=crm-test.example.org
TEST_OIDC_HOST=login.crm-test.example.org
ACME_EMAIL=admin@example.org

# The gate username is fixed as "tester". Generate this hash as documented in
# documents/test-deployment.md; do not put the clear-text password here.
TEST_GATE_PASSWORD_HASH='$2a$14$replace_with_a_caddy_password_hash'

POSTGRES_DB=crm_test
POSTGRES_USER=crm_test
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
FAKE_OIDC_CLIENT_ID=volunteer-crm
FAKE_OIDC_CLIENT_SECRET=replace-with-a-long-random-secret
