// Initial MVP data model for the volunteer CRM.
// A contact can hold a role within one or more groups.

Enum family_relationship_type {
  child
  parent
  guardian
  other
}

Enum contact_status {
  active
  inactive
  archived
}

Enum contact_award_status {
  nominated
  approved
  presented
  declined
}

Table contacts {
  id uuid [pk, default: `gen_random_uuid()`]
  first_name varchar [not null]
  last_name varchar [not null]
  email varchar [unique]
  status contact_status [not null, default: 'active']
  can_login boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]
}

Table role_types {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]
}

Table group_types {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]
}

Table groups {
  id uuid [pk, default: `gen_random_uuid()`]
  group_type_id uuid [not null]
  name varchar [not null]
  description text
  parent_id uuid
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]

  indexes {
    (parent_id, name) [unique]
  }
}

Table family_units {
  id uuid [pk, default: `gen_random_uuid()`]
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]
}

Table award_types {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]
}

Table contact_roles_groups {
  id uuid [pk, default: `gen_random_uuid()`]
  contact_id uuid [not null]
  role_type_id uuid [not null]
  group_id uuid [not null]
  start_date date [not null]
  end_date date
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]

  indexes {
    (contact_id, role_type_id, group_id, start_date) [unique]
  }
}

Table contact_family_units {
  id uuid [pk, default: `gen_random_uuid()`]
  contact_id uuid [not null]
  family_unit_id uuid [not null]
  relationship family_relationship_type [not null]
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]

  indexes {
    (contact_id, family_unit_id, relationship) [unique]
  }
}

Table contact_awards {
  id uuid [pk, default: `gen_random_uuid()`]
  contact_id uuid [not null]
  award_type_id uuid [not null]
  status contact_award_status [not null, default: 'nominated']
  nomination_date date [not null]
  presented_date date
  notes text
  created_at timestamptz [not null, default: `now()`]
  modified_at timestamptz [not null, default: `now()`]

  indexes {
    (contact_id, award_type_id) [unique]
  }
}

Ref: contact_roles_groups.contact_id > contacts.id
Ref: contact_roles_groups.role_type_id > role_types.id
Ref: contact_roles_groups.group_id > groups.id
Ref: groups.group_type_id > group_types.id
Ref: groups.parent_id > groups.id
Ref: contact_family_units.contact_id > contacts.id
Ref: contact_family_units.family_unit_id > family_units.id
Ref: contact_awards.contact_id > contacts.id
Ref: contact_awards.award_type_id > award_types.id
